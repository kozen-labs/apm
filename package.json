{
  "name": "@kozen/apm",
  "version": "1.0.0",
  "description": "APM — Agent Package Manager. Install, update, and manage AI skills and agents across providers.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "apm": "bin/apm"
  },
  "files": [
    "dist",
    "bin/apm",
    "bin/apm.cmd",
    "cfg",
    ".agents/skills",
    ".agents/agents",
    ".agents/apm.json",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && npm run copy:cfg",
    "copy:cfg": "copyfiles -u 1 \"src/configs/*.json\" dist/",
    "build:watch": "tsc --watch",
    "start": "npx kozen --config=cfg/config.json",
    "dev": "ts-node node_modules/@kozen/engine/dist/bin/kozen.js --moduleLoad=. --action=apm:help",
    "mcp:dev": "npx -y @modelcontextprotocol/inspector npx -y ts-node node_modules/@kozen/engine/dist/bin/kozen.js --moduleLoad=. --type=mcp",
    "mcp:start": "ts-node node_modules/@kozen/engine/dist/bin/kozen.js --moduleLoad=. --type=mcp",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "prepublishOnly": "npm run lint && npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "kozen",
    "ai",
    "agents",
    "skills",
    "package-manager",
    "claude",
    "cursor",
    "llm",
    "mongodb",
    "sdlc",
    "mcp"
  ],
  "author": "Antonio Membrides Espinosa <antonio.membrides@mongodb.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mongodb/agent-skills.git"
  },
  "homepage": "https://github.com/mongodb/agent-skills#readme",
  "bugs": {
    "url": "https://github.com/mongodb/agent-skills/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@kozen/engine": "^1.1.15",
    "chalk": "^4.1.2",
    "commander": "^12.1.0",
    "gray-matter": "^4.0.3",
    "inquirer": "^8.2.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/inquirer": "^8.2.10",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.2",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "copyfiles": "^2.4.1",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.2",
    "ts-jest": "^29.1.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
