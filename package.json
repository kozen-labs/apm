{
  "name": "@sdlc/apm",
  "version": "1.0.0",
  "description": "APM — Agent Package Manager. Install, update, and manage AI skills and agents across providers.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "apm": "bin/apm"
  },
  "files": [
    "dist",
    "bin/apm",
    "bin/apm.cmd",
    ".agents/skills",
    ".agents/agents",
    ".agents/apm.json",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "dev": "ts-node src/cli/index.ts",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "prepublishOnly": "npm run lint && npm run build"
  },
  "keywords": [
    "ai", "agents", "skills", "package-manager",
    "claude", "cursor", "llm", "mongodb", "sdlc"
  ],
  "author": "Antonio Membrides Espinosa <antonio.membrides@mongodb.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mongodb/agent-skills.git"
  },
  "homepage": "https://github.com/mongodb/agent-skills#readme",
  "bugs": { "url": "https://github.com/mongodb/agent-skills/issues" },
  "engines": { "node": ">=18.0.0" },
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^12.1.0",
    "gray-matter": "^4.0.3",
    "inquirer": "^8.2.6"
  },
  "devDependencies": {
    "@types/inquirer": "^8.2.10",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.2",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.2",
    "ts-jest": "^29.1.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
